# 开发环境配置（仅 npm run dev 加载）

# 应用信息
VITE_APP_TITLE=AI中医健康管理平台
VITE_APP_SHORT_NAME=中医商城

# 开发环境走 Vite 代理，不需要写绝对地址
VITE_API_BASE_URL=/api/v1
VITE_API_TIMEOUT=30000

# 开发代理后端地址（与 Laravel php artisan serve 一致）
# 使用 127.0.0.1 而非 localhost（避免 Windows 上 IPv6 ::1 解析失败）
VITE_PROXY_TARGET=http://127.0.0.1:8000

# 上传配置
VITE_UPLOAD_MAX_SIZE=2097152
