# ==========================================
# Web 前端环境变量模板（提交到 Git）
# 复制此文件为 .env.local 并填写真实值
# .env.local 已在 .gitignore 中忽略
# ==========================================

# 应用信息
VITE_APP_TITLE=AI中医健康管理平台
VITE_APP_SHORT_NAME=中医商城

# API 基础路径
# 开发环境：通常使用 /api/v1 配合 Vite 代理（见 VITE_PROXY_TARGET）
# 生产环境：使用相对路径（同源部署）或完整 URL（跨域部署）
VITE_API_BASE_URL=/api/v1

# API 请求超时（毫秒）
VITE_API_TIMEOUT=30000

# 仅开发环境生效：Vite 代理目标后端地址
VITE_PROXY_TARGET=http://localhost:8000

# 上传文件最大体积（字节，默认 2MB）
VITE_UPLOAD_MAX_SIZE=2097152
