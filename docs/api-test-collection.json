{
  "info": {
    "name": "中医商城 - 全量 API 测试",
    "description": "覆盖所有模块的端到端 API 测试集合",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://zhongyi.qilewl.net" },
    { "key": "token", "value": "" },
    { "key": "admin_token", "value": "" },
    { "key": "user_id", "value": "" },
    { "key": "order_no", "value": "" },
    { "key": "task_no", "value": "" },
    { "key": "session_no", "value": "" },
    { "key": "package_id", "value": "" },
    { "key": "invite_code", "value": "" }
  ],
  "item": [
    {
      "name": "1. 用户认证",
      "item": [
        {
          "name": "1.1 用户注册（账号）",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"account\",\n  \"account\": \"testuser_{{timestamp}}\",\n  \"password\": \"123456\",\n  \"password_confirmation\": \"123456\",\n  \"invite_code\": \"{{invite_code}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('注册成功', function() {",
                  "  pm.response.to.have.status(200);",
                  "  var data = pm.response.json();",
                  "  pm.expect(data.code).to.eql(0);",
                  "  pm.expect(data.data.token).to.not.be.empty;",
                  "  pm.environment.set('token', data.data.token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 用户注册（手机号）",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"mobile\",\n  \"mobile\": \"1380000{{randomInt}}\",\n  \"sms_code\": \"123456\",\n  \"password\": \"123456\",\n  \"password_confirmation\": \"123456\"\n}"
            }
          }
        },
        {
          "name": "1.3 发送短信验证码",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/sms-code",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"13800000000\",\n  \"type\": \"register\"\n}"
            }
          }
        },
        {
          "name": "1.4 用户登录",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account\": \"testuser\",\n  \"password\": \"123456\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('登录成功', function() {",
                  "  var data = pm.response.json();",
                  "  if (data.code === 0) {",
                  "    pm.environment.set('token', data.data.token);",
                  "    pm.environment.set('user_id', data.data.user.id);",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.5 获取用户信息",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{base_url}}/api/v1/user/info"
          }
        },
        {
          "name": "1.6 退出登录",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{base_url}}/api/v1/user/logout"
          }
        }
      ]
    },
    {
      "name": "2. AI 智能分析",
      "item": [
        {
          "name": "2.1 获取分析配置",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/api/v1/analysis/config"
          }
        },
        {
          "name": "2.2 上传图片",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/api/v1/analysis/upload-image",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "image", "type": "file", "src": "/path/to/test.jpg" }
              ]
            }
          }
        },
        {
          "name": "2.3 提交舌诊（文字）",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/api/v1/analysis/submit",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"tongue\",\n  \"text\": \"舌质红，苔黄腻，有齿痕\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var data = pm.response.json();",
                  "if (data.code === 0) {",
                  "  pm.environment.set('task_no', data.data.task_no);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "2.4 查询分析状态",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/api/v1/analysis/status/{{task_no}}"
          }
        },
        {
          "name": "2.5 获取分析报告",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/api/v1/analysis/report/{{task_no}}"
          }
        },
        {
          "name": "2.6 分析历史",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/api/v1/analysis/history?page=1&limit=10"
          }
        }
      ]
    },
